# SmartCheck Backend Configuration Example
PROJECT_NAME="SmartCheck — Seamless Face ID Attendance System"
VERSION="1.0.0"

# Database Configuration (PostgreSQL in production, SQLite fallback for local dev)
DATABASE_URL="sqlite:///./smartcheck.db"
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smartcheck"

# Security & JWT
JWT_SECRET="generate-a-strong-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Face Recognition Settings
FACE_MATCH_THRESHOLD=0.40
FACE_DISTANCE_THRESHOLD=1.12
LATE_GRACE_MINUTES=15

# CORS Settings (comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
